coverage/
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/

# Backup directory
.malva_source_backup/

# Development screenshots (root level)
*.png
!docs/*.png
!web/icons/*.png
!android/app/src/main/res/**/*.png
# Logo resmi Malva (asset aplikasi, dipakai lintas platform)
!assets/images/*.png
!windows/runner/resources/*.ico

# Local IDE and machine state
.idea/
.vscode/
# Konfigurasi Claude Code lokal (hook graphify terikat ke binary di mesin ini).
# Instruksi portabelnya ada di CLAUDE.md; skill graphify di .agents/skills/.
.claude/
*.iml
*.ipr
*.iws

# Android local machine paths and generated output
android/local.properties
android/key.properties
android/*.jks
android/*.keystore
!android/key.properties.example
android/.gradle/
android/app/build/

# iOS/macOS generated files if those platforms are added later
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Pods/
ios/Runner.xcworkspace/
macos/Flutter/GeneratedPluginRegistrant.swift
macos/Pods/

# Logs and temporary files
*.log
*.tmp
*.temp
flutter_web_stdout.log
flutter_web_stderr.log

# Local Go build artifacts
backend/*.exe
# Artefak coverage Go (dihasilkan go test -coverprofile, dipakai gate CI)
backend/coverage.out
coverage.out

# Graphify knowledge graph output (generated, bukan source code)
graphify-out/

# Local secrets and production environment files
.env
.env.*
!.env.example
!backend/deploy/env.production.example
android/app/google-services.json
firebase-service-account.json
*-service-account.json

# OS files
.DS_Store
Thumbs.db

# Temp file build backend (jangan di-commit)
backend/*.exe~
backend/api.exe
backend/admin.exe
backend/malva-api
malva-api-linux
