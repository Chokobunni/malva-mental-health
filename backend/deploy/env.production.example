# Bind loopback only; Caddy/Nginx will expose HTTPS publicly.
MALVA_HTTP_ADDR=127.0.0.1:8080

# PostgreSQL must stay private/local. Do not expose port 5432 publicly.
MALVA_DATABASE_URL=postgres://malva:replace-with-strong-password@127.0.0.1:5432/malva?sslmode=disable

# Generate with: openssl rand -hex 48
MALVA_JWT_SECRET=replace-with-at-least-32-random-characters

# Comma-separated exact origins. Mobile apps usually send no Origin header.
# WAJIB sertakan origin website publik (landing + Flutter web) agar permintaan
# ber-Origin https://malva.web.id tidak diblokir CORS (tanpa header ACAO, browser
# menolak responsnya). Localhost hanya untuk penelusuran dari mesin dev.
MALVA_ALLOWED_ORIGINS=https://malva.web.id,https://www.malva.web.id,http://localhost:3000,http://localhost:5173,http://localhost:8080

# Use exactly one of these in production.
MALVA_FCM_CREDENTIALS_FILE=/etc/malva/firebase-service-account.json
MALVA_FCM_CREDENTIALS_JSON=

# Blast SOS ke kontak darurat via WhatsApp (gateway Fonnte).
# Token dari dashboard Fonnte (menu Device). Kosong = kanal nonaktif; SOS tidak
# akan mengklaim "terkirim" (blast ditandai failed, UI menampilkan hotline).
MALVA_FONNTE_TOKEN=
# Default https://api.fonnte.com
MALVA_FONNTE_BASE_URL=
