# Bind loopback only; Caddy/Nginx will expose HTTPS publicly.
MALVA_HTTP_ADDR=127.0.0.1:8080

# PostgreSQL must stay private/local. Do not expose port 5432 publicly.
MALVA_DATABASE_URL=postgres://malva:replace-with-strong-password@127.0.0.1:5432/malva?sslmode=disable

# Generate with: openssl rand -hex 48
MALVA_JWT_SECRET=replace-with-at-least-32-random-characters

# Comma-separated exact origins. Mobile apps usually send no Origin header.
MALVA_ALLOWED_ORIGINS=https://api.malva.example.com,https://malva.example.com

# Use exactly one of these in production.
MALVA_FCM_CREDENTIALS_FILE=/etc/malva/firebase-service-account.json
MALVA_FCM_CREDENTIALS_JSON=
