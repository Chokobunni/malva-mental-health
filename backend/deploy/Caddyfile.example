api.malva.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}

# Contoh: Flutter web app disajikan di path /app/ pada host yang sama.
# (Fase 1 Malva memakai https://malva.web.id/app/ karena subdomain belum ada
# DNS. Saat A record tersedia, pakai site block subdomain tersendiri.)
malva.example.com {
	root * /var/www/malva
	encode zstd gzip

	redir /app /app/ 308

	handle_path /app/* {
		root * /var/www/malva-app
		try_files {path} /index.html
		header /index.html Cache-Control "no-cache"
		header / Cache-Control "no-cache"
		header /flutter_service_worker.js Cache-Control "no-cache"
		header /main.dart.js Cache-Control "no-cache"
		header /version.json Cache-Control "no-cache"
		@immutable path /canvaskit/* /assets/* /icons/*
		header @immutable Cache-Control "public, max-age=604800"
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' https://accounts.google.com https://apis.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https://api.malva.example.com wss://api.malva.example.com; frame-src https://accounts.google.com; font-src 'self' data:"
		file_server
	}

	file_server
}
