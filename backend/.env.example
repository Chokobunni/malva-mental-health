# ============================================================
# Malva Backend — Environment Variables (example)
# Salin ke `.env` lalu isi nilainya.
# ============================================================

MALVA_HTTP_ADDR=:8080
MALVA_DATABASE_URL=postgres://malva:CHANGE_ME@localhost:5432/malva?sslmode=disable
MALVA_JWT_SECRET=CHANGE_ME_min_32_chars_random_hex
MALVA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Google Sign-In (login dengan Google).
# Isi dengan **Web OAuth Client ID** dari Google Cloud Console
# (Client ID yang sama dipakai saat build Flutter:
#  --dart-define=MALVA_GOOGLE_CLIENT_ID=...).
# Kosong = endpoint /v1/auth/google menjawab 501.
MALVA_GOOGLE_CLIENT_ID=

# Optional for push notifications. When both are empty, the backend uses a no-op
# provider so local development still works.
MALVA_FCM_CREDENTIALS_FILE=
MALVA_FCM_CREDENTIALS_JSON=

# ============================================================
# Pembayaran (gateway). Mode `simulation` (default) memakai /v1/payments/mark-paid
# untuk dev lokal & test. Mode `gateway` mengaktifkan Midtrans Snap + webhook
# /v1/webhooks/payment dan menonaktifkan mark-paid (410).
# MALVA_MIDTRANS_SERVER_KEY WAJIB bila MALVA_PAYMENT_MODE=gateway.
# ============================================================
MALVA_PAYMENT_MODE=simulation
MALVA_MIDTRANS_SERVER_KEY=
MALVA_MIDTRANS_CLIENT_KEY=
MALVA_MIDTRANS_ENV=sandbox
# Override base URL Snap (opsional; untuk mock/test).
MALVA_MIDTRANS_SNAP_BASE=
