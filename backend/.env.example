# ============================================================
# Malva Backend — Environment Variables (example)
# Salin ke `.env` lalu isi nilainya.
# ============================================================

MALVA_HTTP_ADDR=:8080
MALVA_DATABASE_URL=postgres://malva:CHANGE_ME@localhost:5432/malva?sslmode=disable
MALVA_JWT_SECRET=CHANGE_ME_min_32_chars_random_hex
# Comma-separated exact origins (CORS). Di produksi WAJIB sertakan
# origin website publik: https://malva.web.id (dan https://www.malva.web.id).
# Mobile app tidak mengirim header Origin sehingga tetap diizinkan.
# Kalau origin website tidak didaftarkan, header Access-Control-Allow-Origin
# tidak akan terkirim dan browser memblokir permintaan dari web.
MALVA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://malva.web.id,https://www.malva.web.id

# Google Sign-In (login dengan Google).
# Isi dengan **Web OAuth Client ID** dari Google Cloud Console
# (Client ID yang sama dipakai saat build Flutter:
#  --dart-define=MALVA_GOOGLE_CLIENT_ID=...).
# Kosong = endpoint /v1/auth/google menjawab 501.
MALVA_GOOGLE_CLIENT_ID=

# OAuth client secret Google. Dipakai untuk pertukaran token OAuth
# (authorization code -> refresh/access token) + akses Google Calendar/Meet.
# Kosong = Google Meet nonaktif; sesi video tetap jalan memakai Jitsi (fallback).
MALVA_GOOGLE_CLIENT_SECRET=

# Optional for push notifications. When both are empty, the backend uses a no-op
# provider so local development still works.
MALVA_FCM_CREDENTIALS_FILE=
MALVA_FCM_CREDENTIALS_JSON=
# Optional: Firebase project ID override. Kosong = otomatis dibaca dari
# project_id pada kredensial service account.
MALVA_FCM_PROJECT_ID=

# ============================================================
# Pembayaran (gateway). Mode `simulation` (default) memakai /v1/payments/mark-paid
# untuk dev lokal & test. Mode `gateway` mengaktifkan Midtrans Snap + webhook
# /v1/webhooks/payment dan menonaktifkan mark-paid (410).
# MALVA_MIDTRANS_SERVER_KEY WAJIB bila MALVA_PAYMENT_MODE=gateway.
# ============================================================
MALVA_PAYMENT_MODE=simulation
MALVA_MIDTRANS_SERVER_KEY=
MALVA_MIDTRANS_CLIENT_KEY=
MALVA_MIDTRANS_ENV=sandbox
# Override base URL Snap (opsional; untuk mock/test).
MALVA_MIDTRANS_SNAP_BASE=

# ============================================================
# Blast SOS ke kontak darurat via WhatsApp (gateway Fonnte).
# Ambil token dari dashboard Fonnte (menu Device). Kosong = kanal keluar
# nonaktif: SOS tetap tercatat dan kontak tetap ditandai 'failed', aplikasi
# menampilkan "belum terkirim" + hotline 119 ext 8 — tidak pernah mengaku
# terkirim tanpa transport.
# ============================================================
MALVA_FONNTE_TOKEN=
# Default https://api.fonnte.com — isi hanya untuk mock/test.
MALVA_FONNTE_BASE_URL=

# ============================================================
# Unggah berkas (foto/video profil profesional). Direktori tempat berkas
# unggahan disimpan; disajikan statis di /uploads/.
# ============================================================
MALVA_UPLOAD_DIR=./uploads

# Level log terstruktur: debug | info | warn | error (default: info).
MALVA_LOG_LEVEL=info
