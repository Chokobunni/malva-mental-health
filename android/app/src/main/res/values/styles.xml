<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema saat proses Android mulai (mode terang). Latarnya gradien brand
         Malva, bukan putih, agar tidak ada lompatan warna ke splash Flutter. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Tampilkan splash screen pada activity; otomatis dilepas saat
             Flutter menggambar frame pertama. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema setelah proses berjalan: menentukan warna jendela saat Flutter UI
         diinisialisasi dan di belakang UI Flutter. Memakai warna brand (bukan
         ?android:colorBackground) agar tidak ada kedipan putih di antara splash
         native dan frame pertama Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/malva_window_background</item>
    </style>
</resources>
