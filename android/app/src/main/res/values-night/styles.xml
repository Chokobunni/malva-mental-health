<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema saat proses Android mulai (mode gelap). Latar gradien brand tetap
         dipakai supaya transisi ke splash Flutter mulus di kedua mode. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema setelah proses berjalan: warna brand, bukan ?android:colorBackground
         (yang di mode gelap hampir hitam dan membuat kedipan gelap -> ungu). -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/malva_window_background</item>
    </style>
</resources>
